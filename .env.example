# ─────────────────────────────────────────────
# PulsePass API — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env.
# ─────────────────────────────────────────────

# Servidor
PORT=4000
NODE_ENV=development
# Origem do frontend (CORS). Múltiplas separadas por vírgula.
CORS_ORIGIN=http://localhost:5173

# Supabase (pegue em Project Settings → API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave service_role (server-side, NUNCA exponha no front)
SUPABASE_SERVICE_ROLE_KEY=cole_aqui_a_service_role_key
# Chave publishable/anon (opcional, p/ validar JWT de usuário)
SUPABASE_ANON_KEY=cole_aqui_a_anon_key

# Asaas (sandbox)
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=cole_aqui_sua_api_key_sandbox
# Token que o Asaas enviará no header do webhook (você define no painel)
ASAAS_WEBHOOK_TOKEN=defina_um_token_secreto
# Split/repasse: % retida pela plataforma em cada venda (0 = produtora recebe tudo)
PLATFORM_FEE_PERCENT=0

# URL pública desta API (para callbacks/webhooks)
PUBLIC_API_URL=http://localhost:4000

# Observabilidade (opcional). Sem DSN, o Sentry fica desativado.
SENTRY_DSN=

# Entrega de ingresso por e-mail (opcional, via Resend). Sem isto, não envia.
RESEND_API_KEY=
EMAIL_FROM="PulsePass <ingressos@seudominio.com>"

# Testes de integração (RPCs de dinheiro). Use um projeto Supabase de teste!
# Os testes criam/destroem dados reais. NUNCA aponte para produção.
TEST_SUPABASE_URL=
TEST_SUPABASE_SERVICE_ROLE_KEY=
